rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isOwner() {
      return request.auth != null
        && (
          request.auth.token.owner == true
          || (
            request.auth.token.email_verified == true
            && request.auth.token.email == "fnaticdoc@gmail.com"
          )
        );
    }

    match /meals/personal-user/{fileName} {
      allow read, write: if isOwner();
    }

    match /inbody/personal-user/{fileName} {
      allow read, write: if isOwner();
    }
  }
}
