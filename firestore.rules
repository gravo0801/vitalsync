rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /profiles/{userId} {
      allow read, write: if userId == "personal-user";
    }

    match /weights/{docId} {
      allow read: if resource.data.userId == "personal-user";
      allow create: if request.resource.data.userId == "personal-user";
      allow update, delete: if resource.data.userId == "personal-user";
    }

    match /meals/{docId} {
      allow read: if resource.data.userId == "personal-user";
      allow create: if request.resource.data.userId == "personal-user";
      allow update, delete: if resource.data.userId == "personal-user";
    }

    match /workouts/{docId} {
      allow read: if resource.data.userId == "personal-user";
      allow create: if request.resource.data.userId == "personal-user";
      allow update, delete: if resource.data.userId == "personal-user";
    }

    // ⭐ 인바디 측정 결과
    match /inbody/{docId} {
      allow read: if resource.data.userId == "personal-user";
      allow create: if request.resource.data.userId == "personal-user";
      allow update, delete: if resource.data.userId == "personal-user";
    }
  }
}
